# Configuration locale et production de Houmba H
APP_NAME=Houmba H API
APP_ENV=production
DATABASE_URL=sqlite:///./houmba.db
CORS_ORIGINS=*

# Supabase — ne jamais exposer la service role key au frontend
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Houmba H 1 — fournisseur compatible OpenAI
AI_PROVIDER=openai_compatible
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=45
