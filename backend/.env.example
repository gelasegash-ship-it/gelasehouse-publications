# Configuration locale et production de Houmba H
APP_NAME=Houmba H API
APP_ENV=development
DATABASE_URL=sqlite:///./houmba.db
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://gelasegash-ship-it.github.io

# Houmba H 1 — fournisseur compatible OpenAI
AI_PROVIDER=openai_compatible
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=45

# En production, définir ces valeurs dans les secrets de l’hébergeur.
